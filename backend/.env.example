# Chave da API Stormglass — obrigatória para buscar dados marinhos e meteorológicos
# Obtenha sua chave em: https://stormglass.io
STORMGLASS_API_KEY=your_api_key_here

# ── Cache backend ──────────────────────────────────────────────────────────────
# "file"  → cache local em backend/cache/ (padrão, desenvolvimento)
# "redis" → Upstash Redis via REST API (recomendado em produção)
CACHE_BACKEND=file

# Clima, vento e ondas — TTL curto (dados mudam com frequência)
WEATHER_MARINE_CACHE_TTL_HOURS=1
# Maré — TTL longo (previsões são estáveis ao longo do dia)
TIDE_CACHE_TTL_HOURS=24

# ── Upstash Redis (obrigatório quando CACHE_BACKEND=redis) ─────────────────────
# Crie uma database gratuita em https://upstash.com
# Copie a "REST URL" e o "REST Token" do painel da database
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Configuração de ambiente ────────────────────────────────────────────────────
FLASK_ENV=development
PORT=5000
